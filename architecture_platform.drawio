        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="LEGEND&#xa;&#xa;ARROWS&#xa;──  HTTP REST (public, via Kong)&#xa;──  internal REST (/internal · private Docker net)&#xa;┄ ┄  JWT / OIDC (auth)&#xa;──  DB access&#xa;┄ ┄  transactional outbox → RabbitMQ (publish)&#xa;┄ ┄  RabbitMQ event (consume)&#xa;──  payment redirect · ┄ IPN/return&#xa;──  SMTP&#xa;·····  metrics scrape&#xa;&#xa;NODES&#xa;Blue = client    Orange = gateway    Purple = security/auth&#xa;Green = Java service    Teal = Python service&#xa;Grey = database    Yellow = messaging    Red = dead-letter&#xa;Pink = observability    Tan = external system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1900" y="60" width="960" height="310" as="geometry" />
        </mxCell>

        <!-- ===================== MICROSERVICES ===================== -->
        <mxCell id="svcCustomer" value="Customer Service&#xa;Java Spring Boot · :8081&#xa;&#xa;Identity / Profile&#xa;• register, login, profile, versions&#xa;• admin lock / unlock&#xa;• Keycloak Admin API (users/roles)&#xa;• /internal email lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcProduct" value="Product Service&#xa;Java Spring Boot · :8082&#xa;&#xa;Product Catalog&#xa;• catalog, coverage, loading factors&#xa;• append-only rate versions&#xa;• admin product config&#xa;• /internal products &amp; loading factors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcPricing" value="Pricing Service&#xa;Python FastAPI · :8090 (ctr 8000)&#xa;&#xa;AI Pricing Engine&#xa;• LightGBM + SHAP quotes&#xa;• champion model per insurance line&#xa;• model governance: promote/rollback,&#xa;  validation / fairness / drift reports&#xa;• caches Product / rate data (TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcOrder" value="Order Service&#xa;Java Spring Boot · :8083&#xa;&#xa;Order / Policy&#xa;• orders, issuance, documents&#xa;• renewals, cancellations, endorsements&#xa;• admin review queues&#xa;• calls Pricing (re-rate)&#xa;• calls Billing /internal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcBilling" value="Billing Service&#xa;Java Spring Boot · :8086&#xa;&#xa;Billing / Payment&#xa;• invoices, credits, refunds&#xa;• VNPAY URL / return / IPN&#xa;• calls Order /internal (ownership)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1670" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcClaims" value="Claims Service&#xa;Java Spring Boot · :8085&#xa;&#xa;Claims&#xa;• FNOL, lifecycle, approve / reject&#xa;• misrepresentation, sanctions&#xa;• calls Order /internal&#xa;  (policy / exposure / quote_id)&#xa;• calls Product /internal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2060" y="460" width="240" height="320" as="geometry" />
        </mxCell>
        <mxCell id="svcNotif" value="Notification Service&#xa;Java Spring Boot · :8087&#xa;&#xa;Notifications&#xa;• event-driven in-app + email&#xa;• calls Customer /internal (email)&#xa;• Mailpit SMTP&#xa;• list / unread / mark-read APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
