# Pre-built jar variant for local dev (avoids Gradle download in Docker).
# Build jar first: ./gradlew :services:{SERVICE}:bootJar
# Then: docker compose build --build-arg JAR=services/{SERVICE}/build/libs/{SERVICE}-0.1.0-SNAPSHOT.jar
FROM eclipse-temurin:17-jre
ARG JAR_FILE
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 appuser
COPY ${JAR_FILE} /app/app.jar
USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
