# Resolved GCP staging deployment config — single source of truth for
# deploy/render_k8s.py + the provision/build/deploy scripts.
# Edit here, re-run `python deploy/render_k8s.py`, then re-apply.
#
# Resolved during the staging bring-up (2026-07-03).

# --- GCP project / region ---------------------------------------------------
PROJECT_ID=dpp-staging-260703
REGION=asia-southeast1
ZONE=asia-southeast1-a
GKE_CLUSTER=dpp
NAMESPACE=dpp

# Artifact Registry repo NAME (the region + project are prefixed by the renderer:
# <REGION>-docker.pkg.dev/<PROJECT_ID>/<AR_REPO>/<image>:<tag>)
AR_REPO=dpp

# Image tag (git sha; overwritten by the build script)
IMAGE_TAG=latest

# --- Public domain (Cloud Domains registration dpp-pricing.dev, ACTIVE) ------
BASE_DOMAIN=dpp-pricing.dev
API_HOST=api.dpp-pricing.dev
APP_HOST=app.dpp-pricing.dev
AUTH_HOST=auth.dpp-pricing.dev

# --- Cloud SQL (Postgres 16, private IP) ------------------------------------
# The Cloud SQL Auth Proxy sidecar connects by instance connection name
# (<PROJECT_ID>:<REGION>:<SQL_INSTANCE>), so no private IP is hard-coded here.
SQL_INSTANCE=dpp-pg
DB_USER=platform_user

# --- RabbitMQ (in-cluster StatefulSet) --------------------------------------
RABBITMQ_USER=platform_user

# --- GCS buckets ------------------------------------------------------------
BUCKET_DATASETS=dpp-pricing-datasets-staging
BUCKET_MODELS=dpp-pricing-models-staging
BUCKET_REPORTS=dpp-pricing-reports-staging
BUCKET_REFERENCE=dpp-pricing-reference-staging
BUCKET_FRONTEND=dpp-frontend-staging
