# Dynamic Pricing Platform - local development infrastructure template
# Copy to .env and replace secrets before running outside local demo.

COMPOSE_PROJECT_NAME=dynamic-pricing-platform

# Images
POSTGRES_IMAGE=postgres:16-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.7
KONG_IMAGE=kong:3.8.0
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
NGINX_IMAGE=nginx:1.27-alpine

# Shared PostgreSQL credentials for local containers
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change-me
CUSTOMER_DB_NAME=customer_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
UNDERWRITING_DB_NAME=underwriting_db
CLAIMS_DB_NAME=claims_db
BILLING_DB_NAME=billing_db
NOTIFICATION_DB_NAME=notification_db
PRICING_DB_NAME=pricing_db

# Host ports for local database inspection
CUSTOMER_DB_PORT=5433
PRODUCT_DB_PORT=5434
ORDER_DB_PORT=5435
UNDERWRITING_DB_PORT=5436
CLAIMS_DB_PORT=5437
BILLING_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
PRICING_DB_PORT=5440

# RabbitMQ
RABBITMQ_DEFAULT_USER=platform_user
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080
KEYCLOAK_HEALTH_PORT=9000
KEYCLOAK_REALM=dynamic-pricing

# Demo realm users (seeded via infra/keycloak/realm-export.json) for the
# infrastructure checkpoint and end-to-end demo. Dev-only passwords.
#   demo.customer / demo_customer_dev_only       (role Customer)
#   demo.admin / demo_admin_dev_only             (role Administrator)
# Only two realm roles remain: Customer and Administrator.

# Kong
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_STATUS_PORT=8100
KONG_LOG_LEVEL=notice
KONG_LICENSE_DATA=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
